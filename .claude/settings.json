{
  "permissions": {
    "allow": [
      "Bash(npm install:*)",
      "Bash(npm run:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path // .tool_response.filePath' | { read -r f; echo \"$f\" | grep -qE '\\.(ts|tsx)$' && npm run lint 2>&1 || true; }",
            "timeout": 30,
            "statusMessage": "Running lint..."
          }
        ]
      }
    ]
  }
}
